# PolyMath Tutor 환경변수 샘플 — 로컬 개발용은 .env.local 로 복사

# ─── 데이터 경로 ─────────────────────────────────────────
# 로컬 dev: 생략하면 .polymath-data 사용
# Fly.io: /data (volume mount)
# POLYMATH_DATA_DIR=/data

# ─── AI 공급자 (선택) ────────────────────────────────────
# 서버 측 fallback 키 — 사용자가 설정에 자기 키를 안 넣었을 때 사용.
# 비워두면 사용자별 "데모 응답" 폴백 (유료 요금 없음).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── 오너 계정 Seed (ephemeral 환경 대응) ────────────────
# Render / Fly 처럼 재배포마다 /data 가 초기화되는 환경에서,
# 서버 시작 시 지정된 계정을 자동으로 등록/재동기화해 로그인이 유지되게 함.
# - 비어두면 seed 기능 끔 (기존 동작)
# - 설정하면: 매 재시작마다 이 이메일/비번이 "소스 오브 트루스" 가 됨
# - 이 계정이 자동으로 오너로 식별되어 백업/복원 권한도 가짐
# POLYMATH_SEED_EMAIL=you@example.com
# POLYMATH_SEED_PASSWORD=yourStrongPassword123   # 8자 이상
# POLYMATH_SEED_NAME=민찬

# ─── 인증 데이터 저장 분리 (선택) ────────────────────────
# 지정하면 auth.json 을 별도 디렉토리에 저장 (예: 별도 영구 볼륨)
# POLYMATH_AUTH_DIR=/auth

# ─── 기타 ────────────────────────────────────────────────
# Next.js 가 자동 감지 — 손댈 필요 없음
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
